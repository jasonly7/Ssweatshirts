<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MainActivity">
        <LinearLayout
        android:id="@+id/horizontalLinearLayout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Color"
                android:textSize="15sp">
            </TextView>

            <LinearLayout
                android:id="@+id/horizontalLinearLayout3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                >
                <ImageView
                    android:id="@+id/sweater1"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/blackcrew"
                    android:layout_margin="20dp"
                    android:contentDescription="Draggable Image" />

                <ImageView
                    android:id="@+id/sweater2"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/light_steel_crew"
                    android:layout_margin="20dp"
                    android:contentDescription="Draggable Image 2" />

                <ImageView
                    android:id="@+id/sweater3"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/sand_crew"
                    android:layout_margin="20dp"
                    android:contentDescription="Draggable Image 3" />
            </LinearLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Size"
                android:textSize="15sp">
            </TextView>


            <RadioGroup
                android:id="@+id/sizeRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioOption1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="M"
                    android:textSize="15sp"/>

                <RadioButton
                    android:id="@+id/radioOption2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="L"
                    android:textSize="15sp"/>

                <RadioButton
                    android:id="@+id/radioOption3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="XL"
                    android:textSize="15sp"/>

            </RadioGroup>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Logo"
                android:textSize="15sp">
            </TextView>
            <LinearLayout
                android:id="@+id/horizontalLinearLayout4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                >

                <RadioGroup
                android:id="@+id/logoRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">


                <RadioButton
                    android:id="@+id/logoRadioOption1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vibey"
                    android:textSize="15sp"
                />


                <RadioButton
                    android:id="@+id/logoRadioOption2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Slay"
                    android:textSize="15sp"/>

                <RadioButton
                    android:id="@+id/logoRadioOption3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Maple Leaf"
                    android:textSize="15sp"/>

                <RadioButton
                    android:id="@+id/logoRadioOption4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Initials"
                    android:textSize="15sp"/>

                </RadioGroup>

            </LinearLayout>
            <LinearLayout
                android:id="@+id/horizontalLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                >
                <TextView
                    android:id="@+id/initialsTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Initials"
                    android:visibility="gone"
                    android:textSize="15sp">
                </TextView>
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/initialsTextInput"
                    android:maxLength="4"
                    android:layout_width="200dp"
                    android:layout_height="50dp"
                    android:textSize="15sp"
                    android:visibility="gone"
                    android:hint="4 letters max"/>

            </LinearLayout>

            <FrameLayout
            android:id="@+id/dropTarget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:background="#CCCCCC"
            >
                <ImageView
                    android:id="@+id/shirtImageView"
                    android:layout_width="300dp"
                    android:layout_height="300dp"
                    android:contentDescription="Shirt Image"
                    android:gravity="center"
                    android:src="@drawable/blackcrew"
                    android:scaleType="fitXY"/>


                <ImageView
                    android:id="@+id/selectedImage"
                    android:layout_width="50dp"
                    android:layout_height="50dp"

                    android:contentDescription="Draggable Image"
                    android:gravity="center|center_horizontal|center_vertical" />

                <TextView
                    android:id="@+id/initialsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    >
                </TextView>

            </FrameLayout>

            <LinearLayout
                android:id="@+id/bottomHorizontalLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                >
                <Button
                    android:id="@+id/switch_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Back"
                    android:layout_centerInParent="true"
                    android:textSize="15sp"
                    />
            <Button
                android:id="@+id/submit_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Submit"
                android:layout_centerInParent="true"
                android:textSize="15sp"
                />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</ScrollView>